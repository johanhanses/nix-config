#!/usr/bin/env bash
# Print ANSI + truecolor swatches so you can see what your terminal palette
# (via the Ghostty solitude theme) maps each ANSI slot to, side-by-side with
# the canonical Solitude hex values (greys only; bright red is the one rust).

printf '\n  --- ANSI 8-color (uses your Ghostty palette) ---\n'
for i in 30 31 32 33 34 35 36 37; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

printf '\n  --- ANSI bright ---\n'
for i in 90 91 92 93 94 95 96 97; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

swatch() {
  local hex="$1" name="$2"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))
  printf "  \e[38;2;%d;%d;%dm█████ #%s %s\e[0m\n" "$r" "$g" "$b" "$hex" "$name"
}

printf '\n  --- Truecolor: Solitude ---\n'
swatch cacccc fg
swatch 565d60 'red (dim grey)'
swatch 9fa5a9 'green (light grey)'
swatch d9dbdc 'yellow (near white)'
swatch 798186 'blue (accent grey)'
swatch aeaeae magenta
swatch 707070 cyan
swatch 4b4e55 comment
swatch de6145 'bright red (rust)'

echo
