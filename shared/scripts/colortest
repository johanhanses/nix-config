#!/usr/bin/env bash
# Print ANSI + truecolor swatches so you can see what your terminal palette
# (via the Ghostty github-cb themes) maps each ANSI slot to, side-by-side with
# the canonical GitHub CB Light / Dark hex values (no red/green: "red" is
# orange, "green" is blue).

printf '\n  --- ANSI 8-color (uses your Ghostty palette) ---\n'
for i in 30 31 32 33 34 35 36 37; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

printf '\n  --- ANSI bright ---\n'
for i in 90 91 92 93 94 95 96 97; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

swatch() {
  local hex="$1" name="$2"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))
  printf "  \e[38;2;%d;%d;%dm█████ #%s %s\e[0m\n" "$r" "$g" "$b" "$hex" "$name"
}

printf '\n  --- Truecolor: GitHub CB Light accents ---\n'
swatch 24292f fg
swatch 974b00 'red (orange)'
swatch 0550ae 'green (blue)'
swatch 4d2d00 yellow
swatch 085cbf blue
swatch 7138db magenta
swatch 17686e cyan
swatch 57606a comment

printf '\n  --- Truecolor: GitHub CB Dark accents ---\n'
swatch adbac7 fg
swatch ec8e2c 'red (orange)'
swatch 58a6ff 'green (blue)'
swatch d29922 yellow
swatch 58a6ff blue
swatch bc8cff magenta
swatch 39c5cf cyan
swatch 6e7681 comment

echo
