#!/usr/bin/env bash
# Print ANSI + truecolor swatches so you can see what your terminal palette
# (via Ghostty's bluloco-* theme) maps each ANSI slot to, side-by-side with
# the canonical Bluloco Light / Dark hex values.

printf '\n  --- ANSI 8-color (uses your Ghostty palette) ---\n'
for i in 30 31 32 33 34 35 36 37; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

printf '\n  --- ANSI bright ---\n'
for i in 90 91 92 93 94 95 96 97; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

swatch() {
  local hex="$1" name="$2"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))
  printf "  \e[38;2;%d;%d;%dm█████ #%s %s\e[0m\n" "$r" "$g" "$b" "$hex" "$name"
}

printf '\n  --- Truecolor: Bluloco Light accents ---\n'
swatch 373a41 fg
swatch d52753 red
swatch 23974a green
swatch c5a332 yellow
swatch 275fe4 blue
swatch ce33c0 magenta
swatch 27618d cyan
swatch 9a9ca5 comment

printf '\n  --- Truecolor: Bluloco Dark accents ---\n'
swatch b9c0cb fg
swatch fc2f52 red
swatch 3fc56b green
swatch f9c859 yellow
swatch 10b1fe blue
swatch ff78f8 magenta
swatch 5fb9bc cyan
swatch 6b6f79 comment

echo
