#!/usr/bin/env bash
# Print ANSI + truecolor swatches so you can see what your terminal palette
# (via Ghostty's tokyonight-* theme) maps each ANSI slot to, side-by-side with
# the canonical Tokyo Night Day / Storm hex values.

printf '\n  --- ANSI 8-color (uses your Ghostty palette) ---\n'
for i in 30 31 32 33 34 35 36 37; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

printf '\n  --- ANSI bright ---\n'
for i in 90 91 92 93 94 95 96 97; do
  printf "  \e[${i}m█████ %s\e[0m\n" "code $i"
done

swatch() {
  local hex="$1" name="$2"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))
  printf "  \e[38;2;%d;%d;%dm█████ #%s %s\e[0m\n" "$r" "$g" "$b" "$hex" "$name"
}

printf '\n  --- Truecolor: Tokyo Night Day accents ---\n'
swatch 3760bf fg
swatch f52a65 red
swatch 587539 green
swatch 8c6c3e yellow
swatch 2e7de9 blue
swatch 9854f1 magenta
swatch 007197 cyan
swatch 848cb5 comment

printf '\n  --- Truecolor: Tokyo Night Storm accents ---\n'
swatch c0caf5 fg
swatch f7768e red
swatch 9ece6a green
swatch e0af68 yellow
swatch 7aa2f7 blue
swatch bb9af7 magenta
swatch 7dcfff cyan
swatch 565f89 comment

echo
