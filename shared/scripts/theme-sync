#!/bin/sh
# theme-sync — align terminal-adjacent tools with the current macOS appearance.
# Invoked by the theme-watch agent (on appearance change) and tmux <prefix>+r.
#
# Bluloco Light (light) / Bluloco Dark (dark):
#   - Terminal.app  : switch the profile (requires the two profiles imported)
#   - btop          : rewrite color_theme in the mutable btop.conf
#   - tmux          : source the matching status-bar theme
#   - Mattermost    : push a custom theme via REST (URL from the private
#                     config, token from the login keychain)
#   - bat / fzf / delta / nvim self-follow (ANSI palette / auto-dark-mode)
set -u

# Detect appearance. `defaults read -g AppleInterfaceStyle` is unreliable in
# non-interactive / launchd contexts (cfprefsd returns "does not exist" even in
# dark mode), so use System Events, falling back to defaults.
detect_dark() {
  d=$(osascript -e 'tell application "System Events" to tell appearance preferences to get dark mode' 2>/dev/null)
  case "$d" in
    true) echo dark ;;
    false) echo light ;;
    *) if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then echo dark; else echo light; fi ;;
  esac
}

if [ "$(detect_dark)" = "dark" ]; then
  MODE=dark
  TERM_PROFILE="Bluloco Dark"
  BTOP_THEME="bluloco_dark"
  TMUX_THEME="bluloco-dark"
else
  MODE=light
  TERM_PROFILE="Bluloco Light"
  BTOP_THEME="bluloco_light"
  TMUX_THEME="bluloco-light"
fi

# Terminal.app — set default + all open windows to the matching profile.
if pgrep -x Terminal >/dev/null 2>&1; then
  osascript <<EOF 2>/dev/null || true
tell application "Terminal"
  set default settings to settings set "$TERM_PROFILE"
  set startup settings to settings set "$TERM_PROFILE"
  repeat with w in windows
    try
      set current settings of tabs of w to settings set "$TERM_PROFILE"
    end try
  end repeat
end tell
EOF
fi

# btop — rewrite the theme in the mutable conf.
BTOP_CONF="$HOME/.config/btop/btop.conf"
if [ -f "$BTOP_CONF" ]; then
  /usr/bin/sed -i '' "s/^color_theme = .*/color_theme = \"$BTOP_THEME\"/" "$BTOP_CONF" 2>/dev/null || true
fi

# tmux — source the matching status-bar theme.
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$HOME/.config/tmux/themes/$TMUX_THEME.tmux" >/dev/null 2>&1 || true
fi

# Mattermost Desktop via REST — push a Bluloco custom theme (user + teams).
MM_CFG="$HOME/Repos/github.com/johanhanses/dotfiles-private/mattermost/config"
BL_DARK='{"sidebarBg":"#23272f","sidebarText":"#b9c0cb","sidebarUnreadText":"#cdd4e0","sidebarTextHoverBg":"#44474d","sidebarTextActiveBorder":"#10b1fe","sidebarTextActiveColor":"#cdd4e0","sidebarHeaderBg":"#23272f","sidebarHeaderTextColor":"#b9c0cb","onlineIndicator":"#3fc56b","awayIndicator":"#f9c859","dndIndicator":"#fc2f52","mentionBg":"#10b1fe","mentionColor":"#282c34","centerChannelBg":"#282c34","centerChannelColor":"#b9c0cb","newMessageSeparator":"#ff936a","linkColor":"#10b1fe","buttonBg":"#3476ff","buttonColor":"#ffffff","errorTextColor":"#fc2f52","mentionHighlightBg":"#2c4271","mentionHighlightLink":"#5fb9bc","codeTheme":"monokai","sidebarTeamBarBg":"#23272f"}'
BL_LIGHT='{"sidebarBg":"#eeeef0","sidebarText":"#373a41","sidebarUnreadText":"#1f2126","sidebarTextHoverBg":"#e6e6e7","sidebarTextActiveBorder":"#275fe4","sidebarTextActiveColor":"#1f2126","sidebarHeaderBg":"#e6e6e7","sidebarHeaderTextColor":"#373a41","onlineIndicator":"#23974a","awayIndicator":"#c5a332","dndIndicator":"#d52753","mentionBg":"#275fe4","mentionColor":"#f9f9f9","centerChannelBg":"#f9f9f9","centerChannelColor":"#373a41","newMessageSeparator":"#df631c","linkColor":"#275fe4","buttonBg":"#275fe4","buttonColor":"#f9f9f9","errorTextColor":"#d52753","mentionHighlightBg":"#daf1ff","mentionHighlightLink":"#27618d","codeTheme":"github","sidebarTeamBarBg":"#e6e6e7"}'
if [ -f "$MM_CFG" ] && command -v jq >/dev/null 2>&1; then
  # shellcheck source=/dev/null
  . "$MM_CFG"
  # Token lives in the login keychain, never in git. The config file holds only
  # the URL; MATTERMOST_TOKEN may still be set there as a legacy fallback.
  MATTERMOST_TOKEN=$(security find-generic-password -s mattermost-token -w 2>/dev/null || printf '%s' "${MATTERMOST_TOKEN:-}")
  if [ -n "${MATTERMOST_URL:-}" ] && [ -z "${MATTERMOST_TOKEN:-}" ]; then
    echo "mattermost: skipped — no token in keychain (service 'mattermost-token'); see $MM_CFG" >&2
  fi
  if [ -n "${MATTERMOST_URL:-}" ] && [ -n "${MATTERMOST_TOKEN:-}" ]; then
    if [ "$MODE" = dark ]; then MM_THEME="$BL_DARK"; else MM_THEME="$BL_LIGHT"; fi
    MM_ME=$(curl -s -w '\n%{http_code}' -H "Authorization: Bearer $MATTERMOST_TOKEN" "$MATTERMOST_URL/api/v4/users/me" 2>/dev/null)
    MM_CODE=$(printf '%s' "$MM_ME" | tail -n1)
    if [ "$MM_CODE" = 200 ]; then
      MM_UID=$(printf '%s' "$MM_ME" | sed '$d' | jq -r '.id // empty' 2>/dev/null || true)
    else
      MM_UID=""
      echo "mattermost: skipped — auth failed (HTTP ${MM_CODE:-?}); mint a new token and run: security add-generic-password -s mattermost-token -a $USER -w '<token>' -U -T /usr/bin/security" >&2
    fi
    if [ -n "${MM_UID:-}" ]; then
      MM_PAYLOAD=$(jq -n --arg uid "$MM_UID" --arg theme "$MM_THEME" '[{user_id:$uid,category:"theme",name:"",value:$theme}]')
      for TID in $(curl -sf -H "Authorization: Bearer $MATTERMOST_TOKEN" "$MATTERMOST_URL/api/v4/users/$MM_UID/teams" 2>/dev/null | jq -r '.[].id' 2>/dev/null); do
        MM_PAYLOAD=$(printf '%s' "$MM_PAYLOAD" | jq --arg uid "$MM_UID" --arg tid "$TID" --arg theme "$MM_THEME" '. + [{user_id:$uid,category:"theme",name:$tid,value:$theme}]')
      done
      if curl -sf -X PUT -H "Authorization: Bearer $MATTERMOST_TOKEN" -H "Content-Type: application/json" \
        --data "$MM_PAYLOAD" "$MATTERMOST_URL/api/v4/users/$MM_UID/preferences" >/dev/null 2>&1; then
        echo "mattermost: synced ($MODE)"
      else
        echo "mattermost: preference push failed ($MODE)" >&2
      fi
    fi
  fi
fi

echo "theme-sync: $MODE"
