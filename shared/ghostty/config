# Ghostty — Solitude (Omarchy's greyscale theme), the same in light and dark
# macOS appearance. The theme lives in ./themes and is the canonical palette.
theme = solitude

# Family "CaskaydiaMono Nerd Font" (the full-width NF cut) at 15. The weight is
# NOT set here — the theme file sets `font-style` (currently Regular; Cascadia
# Mono has no Medium), so a per-theme weight stays possible.
font-family = CaskaydiaMono Nerd Font
font-size = 15
adjust-cell-height = 10%

# Window geometry and cursor.
window-width = 120
window-height = 34
cursor-style = block
cursor-style-blink = false
