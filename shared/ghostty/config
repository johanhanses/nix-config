# Ghostty — matches the GitHub CB Dark/Light Terminal.app profiles.
# Themes live in ./themes; Ghostty follows macOS appearance natively,
# so light/dark switching needs no theme-sync wiring.
theme = light:github-cb-light,dark:github-cb-dark

# Same face as Terminal.app (family "JetBrainsMono Nerd Font", the full-width
# NF cut) at 15. The weight is NOT set here — each theme file sets its own
# `font-style` (currently Medium in both), so a per-appearance weight stays
# possible, the way the Terminal.app profiles do it.
font-family = JetBrainsMono Nerd Font
font-size = 15
adjust-cell-height = 10%

# Match the Terminal.app profile geometry and cursor.
window-width = 120
window-height = 34
cursor-style = block
cursor-style-blink = false
