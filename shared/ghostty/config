# Ghostty — matches the Bluloco Dark/Light Terminal.app profiles.
# Themes live in ./themes; Ghostty follows macOS appearance natively,
# so light/dark switching needs no theme-sync wiring.
theme = light:bluloco-light,dark:bluloco-dark

# Same face as Terminal.app (family "Maple Mono NF", upstream's Nerd Font
# build) at 15. The weight is NOT set here — each theme file sets its own
# `font-style` (Medium light / Regular dark), so it switches with the
# appearance the way the Terminal.app profiles do.
font-family = Maple Mono NF
font-size = 15
adjust-cell-height = 10%

# Match the Terminal.app profile geometry and cursor.
window-width = 120
window-height = 34
cursor-style = block
cursor-style-blink = false
