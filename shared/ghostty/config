# Ghostty — matches the Tokyo Night Storm/Day Terminal.app profiles.
# Themes live in ./themes; Ghostty follows macOS appearance natively,
# so light/dark switching needs no theme-sync wiring.
theme = light:tokyonight-day,dark:tokyonight-storm

# Same face as Terminal.app (family "JetBrainsMono Nerd Font", the full-width
# Nerd Font build) at 15. The weight is NOT set here — each theme file sets its own
# `font-style` (Medium light / Regular dark), so it switches with the
# appearance the way the Terminal.app profiles do.
font-family = JetBrainsMono Nerd Font
font-size = 15
adjust-cell-height = 10%

# Match the Terminal.app profile geometry and cursor.
window-width = 120
window-height = 34
cursor-style = block
cursor-style-blink = false
