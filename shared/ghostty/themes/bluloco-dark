# Bluloco Dark — mirrors shared/terminal/gen-terminal.swift (canonical palette).

# A theme file may set any config option except `theme`/`config-file`, so the
# font weight rides along with the appearance switch: one notch lighter than
# light mode, since light-on-dark text blooms and reads heavier.
font-style = Regular

background = #282c34
foreground = #b9c0cb
cursor-color = #ffcc00
cursor-text = #282c34
selection-background = #2c4271
selection-foreground = #cdd4e0

palette = 0=#41444d
palette = 1=#fc2f52
palette = 2=#25a45c
palette = 3=#ff936a
palette = 4=#3476ff
palette = 5=#7a82da
palette = 6=#4483aa
palette = 7=#cdd4e0
palette = 8=#8f9aae
palette = 9=#ff6480
palette = 10=#3fc56b
palette = 11=#f9c859
palette = 12=#10b1fe
palette = 13=#ff78f8
palette = 14=#5fb9bc
palette = 15=#ffffff
