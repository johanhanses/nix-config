# Tokyo Night Day — pale blue-grey ground, deep blue ink

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#e1e2e7"

# Main text color
theme[main_fg]="#3760bf"

# Title color for boxes
theme[title]="#3760bf"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#2e7de9"

# Background color of selected item in processes box
theme[selected_bg]="#d0d5e3"

# Foreground color of selected item in processes box
theme[selected_fg]="#2e7de9"

# Color of inactive/disabled text
theme[inactive_fg]="#848cb5"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#6172b0"

# Background color of the percentage meters
theme[meter_bg]="#d8dbe5"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#6172b0"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#2e7de9" #Blue
theme[mem_box]="#587539" #Green
theme[net_box]="#9854f1" #Purple
theme[proc_box]="#007197" #Cyan

# Box divider line and small boxes line color
theme[div_line]="#c4c8da"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#587539"
theme[temp_mid]="#8c6c3e"
theme[temp_end]="#f52a65"

# CPU graph colors (Green -> Cyan -> Blue)
theme[cpu_start]="#587539"
theme[cpu_mid]="#007197"
theme[cpu_end]="#2e7de9"

# Mem/Disk free meter (Purple -> Blue)
theme[free_start]="#9854f1"
theme[free_mid]="#6368ed"
theme[free_end]="#2e7de9"

# Mem/Disk cached meter (Cyan -> Blue)
theme[cached_start]="#007197"
theme[cached_mid]="#1777c0"
theme[cached_end]="#2e7de9"

# Mem/Disk available meter (Yellow -> Orange)
theme[available_start]="#8c6c3e"
theme[available_mid]="#9e641f"
theme[available_end]="#b15c00"

# Mem/Disk used meter (Green -> Cyan)
theme[used_start]="#587539"
theme[used_mid]="#2c7368"
theme[used_end]="#007197"

# Download graph colors (Yellow -> Red)
theme[download_start]="#8c6c3e"
theme[download_mid]="#c04b51"
theme[download_end]="#f52a65"

# Upload graph colors (Green -> Cyan)
theme[upload_start]="#587539"
theme[upload_mid]="#2c7368"
theme[upload_end]="#007197"

# Process box color gradient for threads, mem and cpu usage (Blue -> Purple)
theme[process_start]="#2e7de9"
theme[process_mid]="#6368ed"
theme[process_end]="#9854f1"
